[gd_resource type="Theme" load_steps=6 format=3]

; Tema base provisional de UI-01. Colores sobrios y neutros hasta tener
; referencias visuales aprobadas del diseño "atlas de mando".
; Tamaños pensados para unos 340 px CSS de alto útil en iPhone horizontal:
; con base 540 px, 26 px de fuente ≈ 16 px reales y 72 px de botón ≈ 45 px reales.

